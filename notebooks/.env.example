# Copy to notebooks/.env and fill in. notebooks/.env is gitignored.
# Any variable left unset falls back to the dbt profile
# (~/.dbt/profiles.yml -> road_construction_autonomy -> target).

# GCP project that runs queries and is billed
BQ_PROJECT=your-gcp-project-id
# BigQuery location of the datasets
BQ_LOCATION=US
# Dataset holding the dbt warehouse models (fact_construction)
BQ_DATASET=your_dbt_dataset_dwh_road_construction
# Dataset holding the dbt intermediate models (int_construction_weather_features)
BQ_INT_DATASET=your_dbt_dataset_int_road_construction

# Optional: path to a service-account JSON key. Leave unset to use
# gcloud Application Default Credentials (`gcloud auth application-default login`),
# which is what the dbt profile uses (method: oauth).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
